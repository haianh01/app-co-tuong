# Sao chép thành .env rồi điền giá trị. Mọi biến đều tùy chọn khi chạy thử trên máy.

# ---- Máy chủ ----
PORT=3000
# Địa chỉ công khai của trang (bắt buộc khi chạy thật: dùng trong email, URL trả về của VNPay, OAuth callback).
PUBLIC_URL=https://kydai.vn
# Các origin được phép mở WebSocket (phân cách dấu phẩy). Bỏ trống = chỉ cùng origin.
ALLOWED_ORIGINS=
# Đặt "false" khi chạy HTTP thuần (không HTTPS), ví dụ thử trong mạng nội bộ.
COOKIE_SECURE=
CONTACT_EMAIL=lienhe@kydai.vn

# ---- Cơ sở dữ liệu ----
# Bỏ trống = dùng PGlite lưu trong .data/pglite (đủ cho chạy thử, không dùng cho nhiều người thật).
DATABASE_URL=postgres://kydai:matkhau@localhost:5432/kydai
PGLITE_DIR=

# ---- Quản trị ----
# Tên đăng nhập (đã đăng ký) được cấp quyền quản trị mỗi lần khởi động. Hoặc: npm run admin:promote -- <tên>
ADMIN_USERNAMES=

# ---- Email (Resend) ----
# Bỏ trống = in email ra log (chỉ khi phát triển).
RESEND_API_KEY=
MAIL_FROM=Kỳ Đài <no-reply@kydai.vn>

# ---- Đăng nhập Google / Facebook ----
# Callback cần khai báo: {PUBLIC_URL}/api/auth/google/callback và {PUBLIC_URL}/api/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Thanh toán ----
# "vnpay" (cần 2 khóa bên dưới) hoặc "mock" (cổng giả lập để thử, KHÔNG bật khi chạy thật). Bỏ trống = tắt thanh toán.
PAYMENT_PROVIDER=
VNP_TMN_CODE=
VNP_HASH_SECRET=
# Mặc định là sandbox. Khi chạy thật: https://pay.vnpay.vn/vpcpay.html
VNP_URL=
# Khai báo IPN URL với VNPay: {PUBLIC_URL}/api/payments/vnpay/ipn

# Repo GitHub RIÊNG TƯ chứa data/ và .data/* (kỳ phổ, phụ đề, cache engine) — npm run data:pull / data:push
DATA_REPO_URL=

# ---- Trợ Lý Live AI & Tường Thuật OBS / TikTok ----
# AI_PROVIDER=gemini hoặc claude. Có GEMINI_API_KEY thì mặc định dùng gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
# TikTok LIVE username (tên sau dấu @, để đọc chat và quà live thật)
TIKTOK_USERNAME=
# Nhân vật, giọng đọc, mẹo kỳ lý, nhắc anh chủ kênh: chỉnh trên trang /tuong-thuat/tro-ly (lưu ở .data/bot-settings.json)

