{
  "name": "app-co-tuong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts --dev",
    "build": "next build",
    "start": "tsx server.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "dev:ui": "next dev",
    "test:e2e": "next build && playwright test",
    "test:unit": "vitest run --project unit --project ui",
    "test:db": "vitest run --project db",
    "test:watch": "vitest --project unit --project ui",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "db:backup": "node scripts/backup-db.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^20.14.6",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
